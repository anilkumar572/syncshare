{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "sharesync-56711",
          "appId": "1:497463857878:android:67f8002c4280e90e0eef77",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "sharesync-56711",
          "configurations": {
            "android": "1:497463857878:android:67f8002c4280e90e0eef77",
            "ios": "1:497463857878:ios:d5235da6606a1a640eef77",
            "web": "1:497463857878:web:0733c03507c9f3e40eef77"
          }
        }
      }
    }
  }
}
